{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2",
      "config": { "includeFiles": "{*.php,includes/**,lib/**,downloads/**}" }
    },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "fonts/**", "use": "@vercel/static" },
    { "src": "downloads/**", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "site.webmanifest", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "//": "Static assets were served with max-age=0, forcing a revalidation round-trip for every file on every visit. Fonts are immutable; images get 30 days; css/js get a day plus a week of stale-while-revalidate because their filenames carry no content hash.",
      "src": "/fonts/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$",
      "headers": { "Cache-Control": "public, max-age=2592000" },
      "continue": true
    },
    {
      "src": "/(css|js)/(.*)",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" },
      "continue": true
    },
    { "src": "/", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)\\.php$", "dest": "/api/index.php" }
  ]
}
